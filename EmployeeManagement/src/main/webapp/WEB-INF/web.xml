<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns="http://xmlns.jcp.org/xml/ns/javaee" xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/javaee http://xmlns.jcp.org/xml/ns/javaee/web-app_4_0.xsd" id="WebApp_ID" version="4.0">
  <display-name>EmployeeManagement</display-name>

  <welcome-file-list>
    <welcome-file>MainDashboard.jsp</welcome-file>
  </welcome-file-list>

  <servlet>
    <servlet-name>FrontControllerServlet</servlet-name>
    <servlet-class>com.project.controller.FrontControllerServlet</servlet-class>
  </servlet>

  <servlet-mapping>
    <servlet-name>FrontControllerServlet</servlet-name>
    <url-pattern>/FrontControllerServlet</url-pattern>
  </servlet-mapping>

  <listener>
    <listener-class>com.project.listener.AppContextListener</listener-class>
  </listener>
</web-app>
